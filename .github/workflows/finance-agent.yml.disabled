name: BB Finance Health Agent (6pm)

on:
  schedule:
    - cron: '0 12 * * 1-6'   # 5:30 PM Sri Lanka (UTC+5:30) Mon-Sat
  workflow_dispatch:

jobs:
  finance-check:
    runs-on: ubuntu-latest
    steps:
      - name: Check finance health
        env:
          SB_URL: https://yyviiwnqgphyklcoijyd.supabase.co/rest/v1
          SB_KEY: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl5dmlpd25xZ3BoeWtsY29panlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU3MjE5OTEsImV4cCI6MjA5MTI5Nzk5MX0.I8YiBr-rfLVcc6DE8Z1PxEP2oxXCelv6mxqAY_wY7lc
          ALERT_URL: https://yyviiwnqgphyklcoijyd.supabase.co/functions/v1/bb-alert
        run: |
          python3 << 'PYEOF'
          import urllib.request, json, os, datetime

          SB    = os.environ['SB_URL']
          KEY   = os.environ['SB_KEY']
          ALERT = os.environ['ALERT_URL']
          HDR   = {"apikey": KEY, "Authorization": f"Bearer {KEY}"}

          def get(path):
              req = urllib.request.Request(f"{SB}/{path}", headers=HDR)
              with urllib.request.urlopen(req) as r:
                  return json.load(r)

          today  = datetime.date.today()
          issues = []

          invoices = get("invoices?status=in.(unpaid,overdue)&select=client_name,amount,due_date,status")
          long_overdue = []
          for inv in invoices:
              if inv.get('due_date'):
                  try:
                      due = datetime.date.fromisoformat(str(inv['due_date'])[:10])
                      days_late = (today - due).days
                      if days_late >= 14:
                          long_overdue.append(f"{inv['client_name']} — LKR {inv['amount']:,} ({days_late}d late)")
                  except: pass

          if long_overdue:
              issues.append("💸 OVERDUE 14+ DAYS:\n" + "\n".join(long_overdue))

          total_unpaid = sum(i.get('amount', 0) for i in invoices)
          if total_unpaid > 0:
              issues.append(f"💰 Total unpaid: LKR {total_unpaid:,} across {len(invoices)} invoice(s)")

          clients = get("clients?select=name,renewal")
          upcoming = []
          for c in clients:
              if c.get('renewal'):
                  try:
                      ren = datetime.date.fromisoformat(str(c['renewal'])[:10])
                      days_left = (ren - today).days
                      if 0 <= days_left <= 7:
                          upcoming.append(f"{c['name']} — renews in {days_left}d")
                  except: pass
          if upcoming:
              issues.append("🔄 RENEWALS THIS WEEK:\n" + "\n".join(upcoming))

          if not issues:
              print("Finance OK — no issues today.")
          else:
              msg = f"💼 BB Finance Alert — {today.strftime('%d %b')}\n\n" + "\n\n".join(issues)
              print(msg)
              payload = json.dumps({"message": msg, "page": "Finance", "role": "ceo"}).encode()
              req = urllib.request.Request(ALERT, data=payload,
                  headers={"Content-Type": "application/json"}, method="POST")
              urllib.request.urlopen(req)
              print("Finance alert sent.")
          PYEOF
